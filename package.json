{
  "name": "taarikh-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for Taarikh date calculation core and accessible date picker",
  "homepage": "https://github.com/hussainweb/taarikh-picker#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hussainweb/taarikh-picker.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build:core": "npm run build -w @taarikh/core",
    "build:picker": "npm run build -w @taarikh/picker",
    "build": "npm run build:core && npm run build:picker && mkdir -p dist && cp -r packages/picker/dist/* dist/",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "check:fallow": "fallow audit",
    "fallow": "fallow",
    "test": "vp test",
    "test:unit": "npm run test -w @taarikh/core",
    "test:browser": "npm run test -w @taarikh/picker",
    "verify:core": "npx publint packages/core && npx attw --pack packages/core",
    "verify:picker": "npx publint packages/picker && npx attw --pack packages/picker",
    "verify": "npm run verify:core && npm run verify:picker && npx size-limit",
    "ci": "npm run check && npm run check:fallow && npm run test && npm run build && npm run verify"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@vitest/browser-playwright": "^5.0.3",
    "axe-core": "^4.14.0",
    "fallow": "^3.33.1",
    "fast-check": "^4.10.2",
    "playwright": "^1.64.0",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "typescript": "~5.8.2",
    "vite-plus": "^1.1.0"
  },
  "size-limit": [
    {
      "name": "Core ESM",
      "path": "packages/core/dist/index.js",
      "limit": "4 KB"
    },
    {
      "name": "Picker ESM",
      "path": "packages/picker/dist/index.js",
      "limit": "8 KB"
    },
    {
      "name": "Picker IIFE (Standalone / Drupal)",
      "path": "dist/index.iife.js",
      "limit": "8 KB"
    }
  ]
}
