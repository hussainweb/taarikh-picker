{
  "name": "@taarikh/picker",
  "version": "0.1.0",
  "description": "Lightweight, accessible Hijri calendar date picker",
  "homepage": "https://github.com/hussainweb/taarikh-picker#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hussainweb/taarikh-picker.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp pack",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "check": "vp check",
    "test": "vp test",
    "ci": "npm run check && npm run test && npm run build && publint && attw --pack && size-limit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@vitest/browser-playwright": "^5.0.3",
    "axe-core": "^4.14.0",
    "fallow": "^3.33.1",
    "fast-check": "^4.10.2",
    "playwright": "^1.64.0",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "typescript": "~5.8.2",
    "vite-plus": "^1.1.0"
  },
  "size-limit": [
    {
      "name": "ESM",
      "path": "dist/index.js",
      "limit": "8 KB"
    },
    {
      "name": "IIFE",
      "path": "dist/index.iife.js",
      "limit": "8 KB"
    }
  ]
}
