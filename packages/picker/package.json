      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "@taarikh/core": "^0.2.1"
  }
}
