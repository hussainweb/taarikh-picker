{
  "name": "@taarikh/picker",
  "version": "0.2.1",
  "description": "Lightweight, accessible Hijri calendar date picker",
  "homepage": "https://github.com/hussainweb/taarikh-picker#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hussainweb/taarikh-picker.git",
    "directory": "packages/picker"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
